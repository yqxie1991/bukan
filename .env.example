# =====================================================================
# 不看 (bukan) - 环境变量示例
# ---------------------------------------------------------------------
# 用法：cp .env.example .env 然后按需修改。
#
# ⚠️ 注意 NEXT_PUBLIC_ 前缀的变量会在「构建时」被内联进客户端产物，
#    运行期再设置对已构建的镜像无效，必须在构建前提供。
#
# 本清单由代码实际读取的 process.env.* 反查得出（14 项），非沿用旧文档。
# =====================================================================

# ==================== 必填 ====================
# 后台管理密码 (/login)。
# docker-compose 使用 ${ADMIN_PASSWORD:?} 强制校验——未设置时部署会直接失败，
# 因此不存在「忘记修改而悄悄回落到默认密码」的可能。
ADMIN_PASSWORD=bukan

# ==================== 应用运行 ====================
NODE_ENV=production
PORT=3000

# 容器时区。alpine 镜像默认 UTC，不设置会让首页「0 点自动更新」实际在北京时间 8 点执行。
TZ=Asia/Shanghai
# 首页缓存跨天判定的时区（应与 TZ 保持一致）。
HOME_CACHE_TIMEZONE=Asia/Shanghai

# 服务端自调用（self-fetch）地址，供豆瓣多源匹配接口请求本服务的 /api/drama/list。
# Docker 单容器内回环可达；Serverless（Vercel）部署请留空，由请求头 Origin 推导。
INTERNAL_ORIGIN=http://127.0.0.1:3000

# 外网访问域名，用于 m3u8 分片「直连 or 中转」的判定（留空则按请求头推断）。
APP_URL=
# 同上，但会内联进客户端产物；两者都设置时优先使用 NEXT_PUBLIC_APP_URL。
NEXT_PUBLIC_APP_URL=

# ==================== 安全相关 ====================
# 登录限流是否信任反代写入的 X-Forwarded-For。
# 经 Lucky/Nginx 反代时保持 true；若为端口直连暴露公网，必须设为 false，
# 否则攻击者可伪造该头绕过登录限流。
TRUST_PROXY=true

# 会话 Cookie 是否带 Secure 标记。
# 注意：生产用的 docker-compose 已默认注入 true（面向 HTTPS 反代部署）；
#      本文件是「本地开发」模板，走 http，故保持 false——
#      否则浏览器不会保存该 Cookie，表现为「登录后又跳回登录页」。
# 若生产环境确实以 http:// 直接对外，请在 .env 中显式设为 false。
SECURE_COOKIE=false

# 服务间内部调用凭证，用于区分「内部自调用」与「外部请求」。
# 留空时每个实例在进程内随机生成（单容器部署无需设置）；
# 仅多实例/多容器需要共享同一凭证时才显式配置。
INTERNAL_TOKEN=

# ==================== 外部接口（NEXT_PUBLIC_* 均为构建期内联） ====================
# 自定义豆瓣中转 API 地址（留空使用内置默认代理）。
NEXT_PUBLIC_DOUBAN_API_URL=
# 弹幕接口地址（留空使用内置默认地址，弹幕功能可正常使用）。
NEXT_PUBLIC_DANMU_API_URL=
# 弹幕接口令牌（留空使用内置默认值）。
NEXT_PUBLIC_DANMU_API_TOKEN=
